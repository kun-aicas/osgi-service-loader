<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <name>OSGi Serviceloader Provider Example</name>
  <groupId>com.aicas.osgi.example</groupId>
  <artifactId>serviceloader-provider-example</artifactId>
  <version>${service-loader.version}</version>
  <packaging>bundle</packaging>
  <description>
    Example provider bundle whose service implementation is registered in the
    OSGi service registry through the osgi.serviceloader.registrar extender and
    can also be loaded using the osgi ServiceLoader API.
  </description>
  
  <properties>
    <service-loader.version>1.0.0-SNAPSHOT</service-loader.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.bundle.plugin.version>6.1.0</maven.bundle.plugin.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>${maven.bundle.plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Import-Package>
              com.aicas.osgi.spi.example.spi
            </Import-Package>
            <Private-Package>
              com.aicas.osgi.spi.example.provider
            </Private-Package>
            <Require-Capability>osgi.extender; filter:="(osgi.extender=osgi.serviceloader.registrar)"</Require-Capability>
            <Provide-Capability>osgi.serviceloader; osgi.serviceloader=com.aicas.osgi.spi.example.spi.SPIProvider</Provide-Capability>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-spi-example</artifactId>
      <version>${service-loader.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi</groupId>
      <artifactId>serviceloader-mediator</artifactId>
      <version>${service-loader.version}</version>
    </dependency>
  </dependencies>
</project>

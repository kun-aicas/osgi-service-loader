<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <name>OSGi Serviceloader OSGi Client Example</name>
  <groupId>com.aicas.osgi.example</groupId>
  <artifactId>serviceloader-osgi-client-example</artifactId>
  <version>${service-loader.version}</version>
  <packaging>bundle</packaging>
  <description>
    Example OSGi client bundle that retrieves an SPIProvider service from the 
    OSGi service registry.
  </description>

  <properties>
    <service-loader.version>1.0.0-SNAPSHOT</service-loader.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.bundle.plugin.version>6.1.0</maven.bundle.plugin.version>
    <osgi.core.version>8.0.0</osgi.core.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>${maven.bundle.plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Import-Package>
              org.osgi.framework;version="[1.6,2)",
              com.aicas.osgi.spi.example.spi
            </Import-Package>
            <Bundle-Activator>com.aicas.osgi.spi.example.client.OsgiClientExampleActivator</Bundle-Activator>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <version>${osgi.core.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-spi-example</artifactId>
      <version>${service-loader.version}</version>
    </dependency>
  </dependencies>
</project>

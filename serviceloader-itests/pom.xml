<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aicas.osgi</groupId>
    <artifactId>service-loader</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>serviceloader-itests</artifactId>
  <name>OSGi ServiceLoader integration tests</name>
  <packaging>jar</packaging>

  <dependencies>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
      <version>7.0.5</version>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <version>${osgi.core.version}</version>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.log</artifactId>
      <version>${osgi.log.version}</version>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.tracker</artifactId>
      <version>${osgi.tracker.version}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi</groupId>
      <artifactId>serviceloader-mediator</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi</groupId>
      <artifactId>serviceloader-weaver</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-spi</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-spi-v2</artifactId>
      <version>2.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-provider-v2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-consumer-v2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-dynamic-import-consumer-v2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-dynamic-import-provider-v2</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-provider-metadata</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-embedded-consumer-bundle</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-consumer-update-example</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-provider-update-example</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-provider-moduleinfo-update-example</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-provider-failure-example</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-two-service-provider-host</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-two-service-provider-fragment</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-provider-moduleinfo</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-consumer</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-provider-fragment</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-provider</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-consumer-metadata</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-osgi-client</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-subclass</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-spi-v2</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-provider-v2</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-consumer-v2</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-dynamic-import-consumer-v2</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-dynamic-import-provider-v2</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-consumer-metadata</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-osgi-client</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-embedded-consumer</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-embedded-consumer-bundle</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-consumer-update-example</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-provider-metadata</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-provider-update-example</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-provider-moduleinfo-update-example</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-provider-failure-example</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-two-service-provider-host</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.testbundle:serviceloader-two-service-provider-fragment</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-provider-moduleinfo</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-consumer</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-provider-fragment</classpathDependencyExclude>
            <classpathDependencyExclude>com.aicas.osgi.example:serviceloader-provider</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

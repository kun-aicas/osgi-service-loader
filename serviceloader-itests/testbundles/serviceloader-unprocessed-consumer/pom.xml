<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aicas.osgi.testbundle</groupId>
    <artifactId>testbundles</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>serviceloader-unprocessed-consumer</artifactId>
  <packaging>bundle</packaging>
  <name>OSGi ServiceLoader unprocessed consumer test bundle</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>${maven.bundle.plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>com.aicas.osgi.testbundle.serviceloader-unprocessed-consumer</Bundle-SymbolicName>
            <Import-Package>
              org.osgi.framework,
              com.aicas.osgi.spi.example.spi
            </Import-Package>
            <Bundle-Activator>com.aicas.osgi.spi.example.consumer.UnprocessedConsumerActivator</Bundle-Activator>
            <Private-Package>com.aicas.osgi.spi.example.consumer</Private-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <version>${osgi.core.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-spi-example</artifactId>
      <version>${revision}</version>
    </dependency>
  </dependencies>
</project>

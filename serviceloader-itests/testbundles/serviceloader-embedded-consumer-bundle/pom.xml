<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.aicas.osgi.testbundle</groupId>
    <artifactId>testbundles</artifactId>
    <version>${revision}</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>serviceloader-embedded-consumer-bundle</artifactId>
  <packaging>bundle</packaging>
  <name>OSGi ServiceLoader embedded consumer test bundle</name>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>create-embedded-consumer-jar</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <zip destfile="${project.build.outputDirectory}/serviceloader-embedded-consumer.jar">
                  <zipfileset dir="${project.basedir}/../serviceloader-embedded-consumer/target/classes" />
                </zip>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>${maven.bundle.plugin.version}</version>
        <extensions>true</extensions>
        <configuration>
          <instructions>
            <Bundle-SymbolicName>com.aicas.osgi.testbundle.serviceloader-embedded-consumer-bundle</Bundle-SymbolicName>
            <Bundle-ClassPath>.,serviceloader-embedded-consumer.jar</Bundle-ClassPath>
            <Include-Resource>serviceloader-embedded-consumer.jar=target/classes/serviceloader-embedded-consumer.jar</Include-Resource>
            <Import-Package>
              org.osgi.framework,
              com.aicas.osgi.spi.example.spi
            </Import-Package>
            <Bundle-Activator>com.aicas.osgi.spi.example.consumer.EmbeddedConsumerActivator</Bundle-Activator>
            <Private-Package>com.aicas.osgi.spi.example.consumer</Private-Package>
            <Require-Capability>osgi.serviceloader; filter:="(osgi.serviceloader=com.aicas.osgi.spi.example.spi.SPIProvider)";cardinality:=multiple,osgi.extender; filter:="(osgi.extender=osgi.serviceloader.processor)"</Require-Capability>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <version>${osgi.core.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.example</groupId>
      <artifactId>serviceloader-spi-example</artifactId>
      <version>${revision}</version>
    </dependency>
    <dependency>
      <groupId>com.aicas.osgi.testbundle</groupId>
      <artifactId>serviceloader-embedded-consumer</artifactId>
      <version>${revision}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
